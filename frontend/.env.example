# Frontend Environment Variables — Example
# Copy to `.env` and adjust per environment. Variables prefixed with VITE_ are
# inlined at build time. The committed `.env` contains a sanitized template only.

# Base URL of the FastAPI backend.
# - Local dev:        http://localhost:8000
# - Docker compose:   http://localhost:8000 (or http://ai-analyst-backend:8000 inside the network)
# - Production:       https://api.your-domain.com
VITE_API_URL=http://localhost:8000

# WebSocket URL for real-time features (e.g. live collaboration).
# Leave blank to disable WebSocket support.
VITE_WS_URL=

# Analytics (optional). Set to "" to disable.
VITE_ANALYTICS_KEY=

# Toggle experimental features (true/false).
VITE_ENABLE_PWA=false
VITE_ENABLE_EXPERIMENTAL_ML=false

# Build-time application name shown in browser title and header.
VITE_APP_NAME=AI Data Analyst Agent

# Sentry DSN (frontend error tracking). Leave blank to disable.
# Get a DSN at https://sentry.io → Project Settings → Client Keys (DSN).
# Example: https://examplePublicKey@o0.ingest.sentry.io/0
VITE_SENTRY_DSN=
