# EditorConfig — maintain consistent coding styles across editors and IDEs
# https://editorconfig.org/

root = true

[*]
charset                  = utf-8
end_of_line              = lf
indent_style             = space
indent_size              = 2
insert_final_newline     = true
trim_trailing_whitespace = true

[*.{py,pyi}]
indent_size              = 4
max_line_length          = 100
trim_trailing_whitespace = true

[*.{md,mdx}]
trim_trailing_whitespace = false

[*.{yml,yaml}]
indent_size              = 2

[Makefile]
indent_style             = tab

[*.md]
indent_size              = 2
