# ==============================================================================
# AI Data Analyst Agent — Environment Template
# ==============================================================================
# Copy this file to `.env` and fill in real values. The committed `.env`
# contains a sanitized template only — it MUST be filled in per-environment.
# ==============================================================================

# Application
APP_NAME=AI Data Analyst Agent
APP_VERSION=2.0.0
APP_ENV=development
LOG_LEVEL=INFO

# JWT signing secret (REQUIRED in production)
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# CORS — comma-separated list of allowed frontend origins (no trailing slash)
# Examples:
#   Local:       http://localhost:5173
#   Docker:     http://localhost
#   Production: https://analyst.your-domain.com
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost

# AI provider
DEFAULT_AI_PROVIDER=gemini
GEMINI_API_KEY=
OPENAI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
OLLAMA_URL=http://localhost:11434

# Upload limits
MAX_FILE_SIZE_MB=100

# ==============================================================================
# Production SaaS — Phase 1
# ==============================================================================

# ── Supabase ──────────────────────────────────────────────────────────────
# Create a free project at https://supabase.com
# Run: python scripts/apply_migrations.py  (after filling in SUPABASE_URL + SERVICE KEY)
# Run: python scripts/seed_demo.py       (once, to create the admin demo account)
SUPABASE_URL=https://your-project.supabase.co
# Use the 'service_role' key (NOT the anon key) — it bypasses RLS for server-side writes.
SUPABASE_SERVICE_KEY=your-service_role-key-here

# ── Resend (Transactional Email) ───────────────────────────────────────
# Sign up at https://resend.com — free tier: 3,000 emails/month
# For dev without a domain, use: api_key_placeholder (emails go to Resend's test inbox)
RESEND_API_KEY=re_your_key_here
# Your verified sending domain, e.g. onboard@yourdomain.com
RESEND_FROM_EMAIL=AI Data Analyst <noreply@yourdomain.com>

# ── Stripe (Billing) ────────────────────────────────────────────────────
# Sign up at https://stripe.com — test mode is always free
# Create two products in the Stripe dashboard:
#   Pro Analyst: $29/month (recurring)
#   Enterprise:  $299/month (recurring)
# Copy the Price IDs (price_xxx) from the Stripe dashboard
STRIPE_SECRET_KEY=sk_test_your_key_here
# Get this from: Stripe Dashboard → Developers → Webhooks → your endpoint → Signing Secret
STRIPE_WEBHOOK_SECRET=whsec_your_secret_here
STRIPE_PRICE_PRO=price_your_pro_price_id_here
STRIPE_PRICE_ENTERPRISE=price_your_enterprise_price_id_here

# ── Frontend URL (used in Stripe redirect URLs) ─────────────────────────
FRONTEND_URL=http://localhost:5173
# Production: https://ai-data-analyst-agent-five.vercel.app
